# ─────────────────────────────────────────────────────────────────────────────
#  Board Meeting Minutes — configuration
#  Copy to .env and edit. Everything here is optional except ACCESS_CODE.
# ─────────────────────────────────────────────────────────────────────────────

# The first administrator code, created on first boot only.
# Change it later in Settings → Access codes; editing it here has no effect
# once the database exists.
ACCESS_CODE=change-me-to-something-long

# Where the SQLite database and uploads live. Mount this as a volume.
DATA_DIR=./data

PORT=8080
NODE_ENV=production

# Public URL, used in share links and emails. No trailing slash.
APP_URL=https://minutes.housingpa.com

# Set to false only if the app is NOT behind a reverse proxy.
BEHIND_PROXY=true

# Sign-in sessions last this many days.
SESSION_DAYS=30

# ── Branding ────────────────────────────────────────────────────────────────
BRAND_NAME=Q&W Community Management
BRAND_SHORT=Q&W
BRAND_TAGLINE=Board Meeting Minutes
SUPPORT_EMAIL=ben@housingpa.com

# ── AI assistance (optional) ────────────────────────────────────────────────
# Without a key the app still writes up notes and summaries using its
# built-in formatter — nothing breaks, the prose is just plainer.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# ── Sending minutes by email (optional) ─────────────────────────────────────
# MAIL_PROVIDER is one of: resend, postmark, sendgrid, mailgun
# Without it, the Send step opens a draft in the manager's own mail client.
# MAIL_PROVIDER=resend
# MAIL_API_KEY=re_xxxxxxxxxxxx
# MAIL_FROM=minutes@housingpa.com
# MAILGUN_DOMAIN=            # only for mailgun

# ── Read-only share links ───────────────────────────────────────────────────
# Set to false to remove the "share link" feature entirely.
SHARING_ENABLED=true
